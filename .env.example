# Use the Next proxy for a backend without browser CORS support.
# Restart Next after changing either URL. Service paths already include /api/v1.
NEXT_PUBLIC_API_URL=
API_PROXY_TARGET=http://localhost:8080
NEXT_PUBLIC_AUTH_STUB=false
# For a backend that allows browser CORS, set NEXT_PUBLIC_API_URL to its origin
# and leave API_PROXY_TARGET empty instead.
# Enable these only while the product/cart backends are unavailable locally.
# NEXT_PUBLIC_PRODUCT_DETAIL_MOCK=true
# NEXT_PUBLIC_CART_MOCK=true
