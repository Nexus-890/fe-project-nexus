# Local default: the browser calls this Next origin; Next forwards /api/v1 to BE.
# The gateway must be running at API_PROXY_TARGET. This is not a mock API.
# Restart Next after changing these values. Service paths already include /api/v1.
NEXT_PUBLIC_API_URL=
# Legacy public-origin fallback must also stay blank while using the proxy.
NEXT_PUBLIC_API_BASE_URL=
API_PROXY_TARGET=http://localhost:8080
# For a backend that allows browser CORS, set NEXT_PUBLIC_API_URL to its origin
# and leave API_PROXY_TARGET empty instead. Use only one of these modes.
# Browser-visible Keycloak base URL. Local realm allows http://localhost:3000.
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:18080
NEXT_PUBLIC_KEYCLOAK_REALM=nexus
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=nexus-web
# Enable after the proposed guest API in docs/features/guest-cart.md is delivered.
# Must match commerce-service nexus.cart.allow-guest-cart.
NEXT_PUBLIC_GUEST_CART_ENABLED=false
# Enable only with the pinned backend #210 email/phone/address operations.
# The develop backend does not support these yet; keep false there.
NEXT_PUBLIC_ACCOUNT_EXTENSIONS_ENABLED=false
# Seller own-read/full DTO proposal is in docs/api/seller-application-210.openapi.json.
# Keep false until backend #210 implements the compatible contract.
NEXT_PUBLIC_SELLER_APPLICATION_ENABLED=false
# Enable these only while the product/cart backends are unavailable locally.
# NEXT_PUBLIC_PRODUCT_DETAIL_MOCK=true
# NEXT_PUBLIC_CART_MOCK=true
